// use prisma-8

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String    // Здесь будет храниться хеш пароля
  name      String?
  products  Product[] // У одного пользователя может быть много товаров
  createdAt DateTime  @default(now())
}

model Product {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  price       Int      // Цена в копейках (например, 10000 = 100 рублей)
  imageUrl    String?  // Ссылка на картинку (пригодится для красоты)
  author      User     @relation(fields: [authorId], references: [id])
  authorId    Int
  createdAt   DateTime @default(now())
}
